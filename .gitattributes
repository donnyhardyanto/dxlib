# Every text file is checked out with LF line endings, whatever core.autocrlf
# says on the clone. go mod vendor copies this file into each consumer's
# vendor/ tree, where it overrides the consumer's own rules, so it must not
# leave the line ending to the clone's settings: with core.autocrlf=true Git
# would check the vendored .go files out as CRLF while go mod vendor writes
# LF, and every file of this module would show as modified.
* text=auto eol=lf

*.go    text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.py    text eol=lf
*.java  text eol=lf
*.md    text eol=lf
*.sh    text eol=lf

# Binary files are never converted
*.png   binary
*.jpg   binary
*.pdf   binary
*.ttf   binary
