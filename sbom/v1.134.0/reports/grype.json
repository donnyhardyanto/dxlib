{"matches":[{"vulnerability":{"id":"GO-2026-6865","dataSource":"https://github.com/klauspost/compress/security/advisories/GHSA-fpmh-frq8-7rj8","namespace":"govulndb:language:go","severity":"High","urls":["https://github.com/klauspost/compress/commit/7f5d8528720c895a6106f201719f87eb030a565d","https://github.com/klauspost/compress/releases/tag/v1.20.2"],"description":"Panic on two-block frames in github.com/klauspost/compress","cvss":[{"source":"security-advisories@github.com","type":"Secondary","version":"4.0","vector":"CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:N/VI:N/VA:H/SC:N/SI:N/SA:N/E:X/CR:X/IR:X/AR:X/MAV:X/MAC:X/MAT:X/MPR:X/MUI:X/MVC:X/MVI:X/MVA:X/MSC:X/MSI:X/MSA:X/S:X/AU:X/R:X/V:X/RE:X/U:X","metrics":{"baseScore":8.7},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2026-116591","epss":0.00333,"percentile":0.26877,"date":"2026-11-14"}],"cwes":[{"cve":"CVE-2026-116591","cwe":"CWE-190","source":"security-advisories@github.com","type":"Secondary"}],"fix":{"versions":["1.20.2"],"state":"fixed","available":[{"version":"1.20.2","date":"2026-10-12","kind":"release"}]},"advisories":[],"risk":0.26972999999999997},"relatedVulnerabilities":[{"id":"CVE-2026-116591","dataSource":"https://nvd.nist.gov/vuln/detail/CVE-2026-116591","namespace":"nvd:cpe","severity":"High","urls":["https://github.com/klauspost/compress/commit/7f5d8528720c895a6106f201719f87eb030a565d","https://github.com/klauspost/compress/releases/tag/v1.20.2","https://github.com/klauspost/compress/security/advisories/GHSA-fpmh-frq8-7rj8"],"description":"compress provides various compression algorithms. Prior to 1.20.2, the zstd DecodeAll and streaming decoder paths can panic when a crafted two-block frame reaches huff0.ReadTable with an FSE normalized count of 32768 that readNCount stores in int16 as -32768. The wrapped count allows buildDtable to retain stale fse.Scratch decode-table state from the prior block, and nextFast then derives an out-of-range state and indexes beyond the table instead of returning a decode error. Both blocks are required to preserve and then reuse the stale state, allowing untrusted zstd input to crash an application. This issue is fixed in version 1.20.2.","cvss":[{"source":"security-advisories@github.com","type":"Secondary","version":"4.0","vector":"CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:N/VI:N/VA:H/SC:N/SI:N/SA:N/E:X/CR:X/IR:X/AR:X/MAV:X/MAC:X/MAT:X/MPR:X/MUI:X/MVC:X/MVI:X/MVA:X/MSC:X/MSI:X/MSA:X/S:X/AU:X/R:X/V:X/RE:X/U:X","metrics":{"baseScore":8.7},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2026-116591","epss":0.00333,"percentile":0.26877,"date":"2026-11-14"}],"cwes":[{"cve":"CVE-2026-116591","cwe":"CWE-190","source":"security-advisories@github.com","type":"Secondary"}]},{"id":"GHSA-fpmh-frq8-7rj8","dataSource":"https://github.com/advisories/GHSA-fpmh-frq8-7rj8","namespace":"github:language:go","severity":"High","urls":["https://github.com/klauspost/compress/security/advisories/GHSA-fpmh-frq8-7rj8","https://nvd.nist.gov/vuln/detail/CVE-2026-116591","https://github.com/klauspost/compress/commit/7f5d8528720c895a6106f201719f87eb030a565d","https://github.com/klauspost/compress/releases/tag/v1.20.2"],"description":"compress zstd: Panic on two-block frames","cvss":[{"type":"Secondary","version":"4.0","vector":"CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:N/VI:N/VA:H/SC:N/SI:N/SA:N","metrics":{"baseScore":8.7},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2026-116591","epss":0.00333,"percentile":0.26877,"date":"2026-11-14"}],"cwes":[{"cve":"CVE-2026-116591","cwe":"CWE-190","source":"security-advisories@github.com","type":"Secondary"}]}],"matchDetails":[{"type":"exact-direct-match","matcher":"go-module-matcher","searchedBy":{"language":"go","namespace":"govulndb:language:go","package":{"name":"github.com/klauspost/compress","version":"v1.20.1"}},"found":{"vulnerabilityID":"GO-2026-6865","versionConstraint":"<1.20.2 (go)"},"fix":{"suggestedVersion":"1.20.2"}}],"artifact":{"id":"pkg:golang/github.com/klauspost/compress@v1.20.1?package-id=7c9fc9fc997a453a","name":"github.com/